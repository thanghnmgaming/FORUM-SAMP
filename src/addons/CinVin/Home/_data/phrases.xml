  <phrase title="option_explain.cinvinHome_AutoEnableHome" version_id="1000070" version_string="1.0.0"><![CDATA[Should the CinVin Home page be automatically displayed as the "Home" page link.  If disabled the page is still reachable at <code>/cv-home</code> and will still work but an automatic link will not be automatically added to the navigation bar.<br />
[Default: True]]]></phrase>
  <phrase title="option_explain.cinvinHome_BoardDescription" version_id="1000070" version_string="1.0.0"><![CDATA[Enter a description for your Home page. This will be placed inside the meta description tag for the Home page, so avoid using HTML.  If left blank then the standard <a href="admin.php?options/boardDescription/view" target="_self">Board meta description</a> will be used.<br />[Default: <a href="admin.php?options/boardDescription/view" target="_self">Board meta description</a>]]]></phrase>
  <phrase title="option_explain.cinvinHome_DisplayBoardDescription" version_id="1000070" version_string="1.0.0"><![CDATA[Display the <a href="admin.php?options/cinvinHome_BoardDescription/view" target="_self">Home Page Description</a> on the Home page.  If this option is enabled and if the Home Page Description is blank then the standard <a href="admin.php?options/boardDescription/view" target="_self">Board Meta Description</a> will be shown.
<br />[Default: True]]]></phrase>
  <phrase title="option_explain.cinvinHome_DisplayBoardTitle" version_id="1000070" version_string="1.0.0"><![CDATA[Display the <a href="admin.php?options/boardTitle/view" target="_self">Board Title</a> on the Home page.
