<?xml version="1.0" encoding="utf-8"?>
<style_properties>
  <style_property property_name="th_backgroundSelector_nodes" group_name="thnodes_styling" title="Background selector" description="This is the selector that should be used to place the background image and color on a node, if selected." property_type="value" value_type="string" display_order="100">
    <value>".node--id{node_id} &gt; .node-body"</value>
  </style_property>
  <style_property property_name="th_enableGrid_nodes" group_name="thnodes_grid" title="Enable node grid" property_type="value" value_type="boolean" display_order="0">
    <value>0</value>
  </style_property>
  <style_property property_name="th_enableNodeFooter_nodes" group_name="thnodes_grid" title="Enable node footer" property_type="value" value_type="boolean" display_order="5">
    <value>1</value>
  </style_property>
  <style_property property_name="th_enableStyling_nodes" group_name="thnodes_styling" title="Enable node styling" property_type="value" value_type="boolean" display_order="0">
    <value>false</value>
  </style_property>
  <style_property property_name="th_imageOverlay" group_name="thnodes_styling" title="Image overlay" property_type="value" value_type="color" display_order="5">
    <value>"rgba(0,0,0,.3)"</value>
  </style_property>
  <style_property property_name="th_nodeBody" group_name="thnodes_styling" title="Node body" property_type="css" display_order="0" css_components="background,border,border_radius,padding,extra">
    <value>{
    "border-radius": "@xf-borderRadiusSmall"
}</value>
  </style_property>
  <style_property property_name="th_nodeGutter" group_name="thnodes_grid" title="Node gutter" description="Adds a gutter space in between nodes" property_type="value" value_type="unit" display_order="0">
    <value>"10px"</value>
  </style_property>
  <style_property property_name="th_textSelector_nodes" group_name="thnodes_styling" title="Text selector" property_type="value" value_type="string" display_order="105">
    <value>".node--id{node_id} &gt; .node-body, .node--id{node_id} &gt; .node-body a"</value>
  </style_property>
  <style_property property_name="thnodes_enable_header_styling_categoryView" group_name="thnodes_styling" title="Enable header styling on category view" description="If enabled, node background image, background &amp; font color will be applied to the titlebar in category view of the respective category." property_type="value" value_type="boolean" display_order="210">
    <value>0</value>
  </style_property>
  <style_property property_name="thnodes_enable_header_styling_forumView" group_name="thnodes_styling" title="Enable header styling on forum view" description="If enabled, node background image, background &amp; font color will be applied to the titlebar in forum view of the respective forum." property_type="value" value_type="boolean" display_order="200">
    <value>0</value>
  </style_property>
  <style_property property_name="thnodes_enable_header_styling_threadView" group_name="thnodes_styling" title="Enable header styling on thread view" description="If enabled, node background image, background &amp; font color will be applied to the titlebar in thread view of the respective forum." property_type="value" value_type="boolean" display_order="205">
    <value>0</value>
  </style_property>
  <style_property property_name="thnodes_enable_icons" group_name="thnodes_icons" title="Enable node icons" property_type="value" value_type="boolean" display_order="0">
    <value>1</value>
  </style_property>
  <style_property property_name="thnodes_show_header_icon" group_name="thnodes_icons" title="Show icon in header" description="If any of the above header options are enabled, this will additionally show the respective icon, if set." property_type="value" value_type="boolean" display_order="100">
    <value>0</value>
  </style_property>
</style_properties>
