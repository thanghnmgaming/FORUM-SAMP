<ul class="content {$tab.tab_class}">
    <xf:if is="$users is not empty">

        <xf:foreach loop="$users" value="$user">
            <xf:set var="$rightIcon">
				<span title="{{ phrase('messages:') }} {$user.message_count}" data-xf-init="tooltip" class="item--info">
					<xf:fa icon="far fa-comments" /> {$user.message_count}
				</span>
            </xf:set>

            <xf:macro template="lfs_tab_member_definition_macros"
                      name="user_item"
                      arg-user="{$user}"
                      arg-rightIcon="{$rightIcon}" />
        </xf:foreach>

        <xf:else />

        <xf:macro template="lfs_macros" name="empty_block" />

    </xf:if>
</ul>